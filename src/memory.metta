;Configured at runtime memory and history in amount of characters:
(= (maxFeedback) (empty))
(= (maxRecallItems) (empty))
(= (maxSimilarityRecall) (empty))
(= (maxEpisodeRecallLines) (empty))
(= (maxHistory) (empty))
(= (embeddingprovider) (empty))
(= (promotionInflationFactor) (empty))
(= (mostPromotedMemories) (empty))

(= (initMemory)
   (progn (println! "Initializing memory")
          (configure maxFeedback 50000)
          (configure maxRecallItems 10)
          (configure maxSimilarityRecall 10)
          (configure maxEpisodeRecallLines 20)
          (configure maxHistory 30000)
          (configure embeddingprovider OpenAI) ;OpenAI or Local
          (configure promotionInflationFactor 10)
          (configure mostPromotedMemories 10)
          (py-call (helper.promotion_open_map))
          (if (== (embeddingprovider) Local)
              (py-call (lib_llm_ext.initLocalEmbedding)) _)))

(= (getPrompt)
   (read-file (library mettaclaw ./memory/prompt.txt)))

(= (getHistory)
   (let $ret (read-file (library mettaclaw ./memory/history.metta))
        (last_chars $ret (maxHistory))))

(= (addToHistory $lastmessage $response $sexpr $msgnew)
   (if $msgnew
       (if (== (get-state &error) ())
           (appendToHistory ((get_time_as_string) (newline) "HUMAN_MESSAGE: " $lastmessage (newline) $response (newline)))
           (appendToHistory ((get_time_as_string) (newline) "HUMAN_MESSAGE: " $lastmessage (newline) $response (newline) ERROR_FEEDBACK: (get-state &error))))
       (if (== (get-state &error) ())
           (appendToHistory ((get_time_as_string) (newline) $response (newline)))
           (appendToHistory ((get_time_as_string) (newline) $response (newline) ERROR_FEEDBACK: (get-state &error))))))

(= (embed $str)
   (if (== (embeddingprovider) Local)
       (py-call (lib_llm_ext.useLocalEmbedding (string-safe $str)))
       (useGPTEmbedding (string-safe $str))))

(= (appendToHistory $addition)
   (append-file (library mettaclaw ./memory/history.metta) (swrite $addition)))

(= (createMemory $str)
   (let* (($current_time_str (get_time_as_string))
          ($uuid (py-call (lib_chromadb.remember $str (embed $str) $current_time_str))))
         (progn (py-call (lib_chromadb.link_episode $uuid $current_time_str))
                $uuid)))

(= (remember $str)
   (progn (createMemory $str)
          REMEMBER-SUCCESS))

(= (update $ttime $newStr)
   (let* (($time (replace_underscores $ttime))
          ($oldids (py-call (lib_chromadb.ids_by_time $time)))
          ($memories (py-call (lib_chromadb.query_by_ids $oldids)))
          ($episodesPre (collapse (let* ((($oldid $t $c) (superpose $memories))
                                      ($L (py-call (lib_chromadb.query_linked_episodes $oldid))))
                                    (superpose $L))))
          ($episodes (if (== $episodesPre ()) ;old system did not have it so we import the creation time episode at least, while new always has it
                         ($time)
                         $episodesPre)))
         (if (!= $oldids ())
             (let $newid (createMemory $newStr)
                  (progn (py-call (lib_chromadb.forget_ids $oldids))
                         (collapse (let $episode (superpose $episodes)
                                        (py-call (lib_chromadb.link_episode $newid $episode))))
                         (collapse (let* (($oldid (superpose $oldids))
                                          ($lasttime (py-call (helper.promotion_get_lasttime $oldid 0.0)))
                                          ($lastvalue (py-call (helper.promotion_get_value $oldid 0.0)))
                                          (($s $c) (py-call (lib_chromadb.get_stv $oldid))))
                                         (progn (py-call (helper.promotion_delete_key $oldid))
                                                (py-call (helper.promotion_set_lasttime $newid $lasttime))
                                                (py-call (helper.promotion_set_value $newid $lastvalue))
                                                (if (!= ($s $c) (1.0 0.5))
                                                    (py-call (lib_chromadb.set_stv $newid $s $c)) _))))
                         (py-call (helper.promotion_commit))
                         UPDATE-SUCCESS))
             UPDATE-FAILED-LTM-ITEM-OF-TIME-DID-NOT-EXIST)))

(= (tvUpdate $time $sign)
   (progn (promote $time)
          (let $oldids (py-call (lib_chromadb.ids_by_time $time))
               (if (!= $oldids ())
                   (progn (collapse (let* (($oldid (superpose $oldids))
                                          (($s $c) (py-call (lib_chromadb.get_stv $oldid)))
                                          (($snew $cnew) (Truth_Revision (stv $s $c) (stv (if $sign 1.0 0.0) 0.5))))
                                         (py-call (lib_chromadb.set_stv $oldid $snew $cnew))))
                          REVISION-SUCCESS)
                   REVISION-FAILED-LTM-ITEM-OF-TIME-DID-NOT-EXIST))))

(= (support $time)
   (tvUpdate $time True))

(= (contradict $time)
   (tvUpdate $time False))

(= (best-promoted-memory-ids)
   (let* (($current_time (get_time))
          ($uuids (py-call (helper.promotion_get_all_keys)))
          ($ranked (takeK (mostPromotedMemories)
                          (msort (collapse (let* (($uuid (superpose $uuids))
                                                  ($promotion (get-promotion $current_time $uuid)))
                                                 (if (> $promotion 0.0) ((- 0.0 $promotion) $uuid))))))))
         (collapse (let ($p $uuid) (superpose $ranked) $uuid))))

(= (best-promoted-memories)
   (let $uuids (best-promoted-memory-ids)
        (let $ret (py-call (lib_chromadb.query_by_ids $uuids))
             (progn (write-file ./repos/mettaclaw/memory/promoted_memories.metta "")
                    (repr (collapse (let ($uuid $t $c) (superpose $ret)
                                         (progn (append-file ./repos/mettaclaw/memory/promoted_memories.metta (repr ($t $c)))
                                                ((id: $t) (linkedEpisodes: (py-call (lib_chromadb.query_linked_episodes $uuid))) $c)))))))))

(= (get-promotion $current_time $uuid)
   (let* (($promotion (py-call (helper.promotion_get_value $uuid 0.0)))
          ($last_time (py-call (helper.promotion_get_lasttime $uuid 0.0)))
          ($t (- $current_time $last_time)))
         (* $promotion (pow-math (+ 1.0 (/ $t 86400.0)) (- 0.0 0.7)))))

(= (query $str)
   (let* (($embedding (embed $str))
          ($queryresults (py-call (lib_chromadb.query_with_ids_and_dists $embedding (* (promotionInflationFactor) (maxRecallItems)))))
          ($current_time (get_time))
          ($candidates (collapse (let* ((($uuid $time $message $distance) (superpose $queryresults))
                                        ($promotion (get-promotion $current_time $uuid)))
                                       (if (> $promotion 0.0)
                                           ((- 0.0 $promotion) $distance $uuid $time (linkedEpisodes: (py-call (lib_chromadb.query_linked_episodes $uuid))) $message))))))
             (let* (($best (takeK (maxRecallItems) (msort $candidates)))
                    ($bestpromoted (collapse (let ($_ $_ $uuid $time $episodes $message) (superpose $best)
                                                  ((id: $time) $episodes $message))))
                    ($closest (collapse (let ($uuid $time $message $distance) (superpose $queryresults)
                               ((id: $time) (linkedEpisodes: (py-call (lib_chromadb.query_linked_episodes $uuid))) $message)))))
                   (takeK (+ (maxRecallItems) (maxSimilarityRecall)) (unique-atom (append $bestpromoted $closest))))))

(= (episodes $time)
   (py-call (helper.around_time $time (maxEpisodeRecallLines))))

(= (promote $time)
   (let* (($current_time (get_time))
          ($current_time_str (get_time_as_string))
          ($uuids (py-call (lib_chromadb.ids_by_time $time))))
         (progn (collapse (let* (($uuid (superpose $uuids))
                                 ($v (get-promotion $current_time $uuid)))
                                (progn (py-call (lib_chromadb.link_episode $uuid $current_time_str))
                                       (py-call (helper.promotion_set_value $uuid (min 10.0 (+ 1.0 $v))))
                                       (py-call (helper.promotion_set_lasttime $uuid $current_time)))))
                (py-call (helper.promotion_commit))
                PROMOTE-SUCCESS)))

(= (demote $time)
   (let* (($current_time (get_time))
          ($uuids (py-call (lib_chromadb.ids_by_time $time))))
         (progn (collapse (let* (($uuid (superpose $uuids))
                                 ($v (get-promotion $current_time $uuid)))
                                (progn (py-call (helper.promotion_set_value $uuid (max 0.0 (- $v 1.0))))
                                       (py-call (helper.promotion_set_lasttime $uuid $current_time)))))
                (py-call (helper.promotion_commit))
                DEMOTE-SUCCESS)))

(= (link $LTM_time $EPISODE_time)
   (let* (($ltm_time (replace_underscores $LTM_time))
          ($episode_time (replace_underscores $EPISODE_time))
          ($uuids (py-call (lib_chromadb.ids_by_time $ltm_time))))
        (progn (collapse (let $uuid (superpose $uuids)
                              (py-call (lib_chromadb.link_episode $uuid $episode_time))))
               (if (== $uuids ())
                   LINK-FAIL-LTM-ITEM-NOT-EXISTING
                   LINK-SUCCESS))))

(= (unlink $LTM_time $EPISODE_time)
   (let* (($ltm_time (replace_underscores $LTM_time))
          ($episode_time (replace_underscores $EPISODE_time))
          ($uuids (py-call (lib_chromadb.ids_by_time $ltm_time))))
        (progn (collapse (let $uuid (superpose $uuids)
                              (py-call (lib_chromadb.unlink_episode $uuid $episode_time))))
               (if (== $uuids ())
                   UNLINK-FAIL-LTM-ITEM-NOT-EXISTING
                   UNLINK-SUCCESS))))
